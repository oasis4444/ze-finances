rules_version = '2';
// Règles de sécurité Z&E : seuls les deux comptes listés, avec e-mail vérifié,
// peuvent lire et écrire les données du foyer.
service cloud.firestore {
  match /databases/{database}/documents {
    function isMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'manirisoazakatina@gmail.com',
          'manirisoazakatiana@gmail.com'
        ];
    }
    match /households/ze/{document=**} {
      allow read, write: if isMember();
    }
  }
}
