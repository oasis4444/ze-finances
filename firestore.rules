rules_version = '2';
// Règles de sécurité Z&E : seuls les deux comptes listés peuvent lire et écrire.
// Remplacez les deux adresses e-mail, puis copiez ce texte dans
// Console Firebase → Firestore Database → Règles → Publier.
service cloud.firestore {
  match /databases/{database}/documents {
    function isMember() {
      return request.auth != null
        && request.auth.token.email.lower() in [
          'EMAIL_MARI@gmail.com'.lower(),
          'EMAIL_EPOUSE@gmail.com'.lower()
        ];
    }
    match /households/ze/{document=**} {
      allow read, write: if isMember();
    }
  }
}
